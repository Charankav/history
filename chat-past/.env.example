# Chat Past — Server-Side Environment Configuration
# Copy this file to .env.local and supply your own private Anthropic API key.
# NEVER commit .env.local to Git or prefix secret keys with NEXT_PUBLIC_.

ANTHROPIC_API_KEY=replace_with_your_key
ANTHROPIC_MODEL=claude-haiku-5-5

# Optional Rate Limiting Override (Defaults configured in src/config/limits.ts)
RATE_LIMIT_RPM=5
RATE_LIMIT_RPD=30
MAX_USER_MESSAGE_CHARS=500
MAX_CONVERSATION_MESSAGES=12
MAX_OUTPUT_TOKENS=280
